<%layout("/layouts/boilerPlate")%> 
<body>

  
    <h3 class="headline mt-3">All listings of Housing</h3>
    <br>
    <div class="Cards row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <% for(let list of allListings){%>
        <a href="/listings/<%=list._id%>" class="listings-link">
        <div class="card" style="width: 18rem;">
            <img src="<%=list.image.url%>" class="card-img-top" alt="House Image" style="height:20rem">
            <div class="card-img-overlay"></div>
            <div class="card-body">
                <p class="card-text"><b><%=list.title%></b></p>
                <p>Price: &#8377; <%=list.price?.toLocaleString("en-IN")%>/night</p>
            </div>
        </div>
        </a>
       <%}%>
    </div>
    <form action="/listings/new" method="GET">
        <button class="btn btn-dark mb-3">Add New List</button>
    </form>
    
</body>

